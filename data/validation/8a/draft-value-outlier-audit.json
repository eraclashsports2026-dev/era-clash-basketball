  "reviewFindings": [
    {
      "pattern": "Versatile two-way wings and multi-position bigs rate above their OVR rank.",
      "verdict": "MODEL_WORKING_AS_DESIGNED",
      "reason": "Positional flexibility and off-ball scalability are explicit model components; a card that fits anywhere genuinely constrains a draft more."
    },
    {
      "pattern": "High-volume single-position scorers rate below their OVR rank.",
      "verdict": "MODEL_WORKING_AS_DESIGNED",
      "reason": "Ball-dominant scoring does not survive a usage cut next to another star, which is exactly the off-ball scalability term."
    },
    {
      "pattern": "Pre-1974 cards carry 0.0 STL and 0.0 BLK because the NBA did not record them.",
      "verdict": "SOURCE_LIMITATION_NOT_A_DEFECT",
      "reason": "These cards lose two-way breadth they may have deserved. Correcting it would require inventing statistics. The limitation is disclosed rather than patched, and it depresses their Draft Value, which makes them MORE available in the draft, not less."
    },
    {
      "pattern": "One person holding several decade cards receives an independent Draft Value per card.",
      "verdict": "CORRECT",
      "reason": "The cards describe different players at different times; person-uniqueness is enforced separately at draw time."
    }
  ]
}
