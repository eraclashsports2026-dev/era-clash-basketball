# ── EraClash Basketball environment ───────────────────────────────────────────
# Copy to .env (or .env.local) for local development. NEVER commit real values.
#
# Almost everything here is server-side only. The two exceptions are the
# Supabase project URL and its ANON key, which are prefixed VITE_ on purpose:
# they are meant to be in the browser bundle, and row level security is what
# protects the data behind them. The SERVICE ROLE key is the opposite — it
# bypasses every policy, so it must never carry a VITE_ prefix, never be
# committed, and never appear in a log, an artifact or a screenshot.

# ─ Required ─────────────────────────────────────────────────────────────────
# Anthropic API key for the AI narrative layer (server-side only; the core
# game works without it — narration degrades to the deterministic recap).
ANTHROPIC_API_KEY=

# ─ Persistence (either pair; without it the app runs local-only) ────────────
# Upstash Redis REST (or Vercel KV equivalents KV_REST_API_URL/KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─ Real accounts and cloud career (Phase 9B.1; off unless all four are set) ──
# Browser-visible BY DESIGN. Row level security is the protection, not secrecy.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_CLOUD_ACCOUNTS_ENABLED=true
#
# Server-side only. The service-role key bypasses row level security: it is
# used by api/_lib/cloudAccounts.js to write a career record AFTER the server
# has verified the account token and proved the result belongs to the caller.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# CLOUD_ACCOUNTS_ENABLED=true
#
# Check the wiring without printing any value:
#   npm run account:verify-provider-local
# Full setup steps: docs/accounts/eraclash-account-provider-setup.md

# ─ Feature flags (all optional; defaults shown) ─────────────────────────────
# MAINTENANCE_MODE=false           # mutations 503, reads stay up
# AI_NARRATIVE_ENABLED=true        # off → fallback recap only, game unaffected
# CHALLENGES_ENABLED=true
# DAILY_ENABLED=true
# PUBLIC_LEADERBOARD_ENABLED=true
# FEEDBACK_ENABLED=true

# ─ Rate limits / cost guards (optional; defaults shown) ─────────────────────
# RL_SIM_PER_MIN_SESSION=10
# RL_SIM_PER_MIN_IP=20
# RL_NARRATIVE_PER_MIN_SESSION=6
# RL_CHALLENGE_PER_MIN_IP=30
# RL_FEEDBACK_PER_MIN_IP=20
# RL_EVENTS_PER_MIN_IP=120
# RL_PROFILE_PER_MIN_IP=20
# MAX_CORE_SIMULATIONS_PER_MINUTE=600
# MAX_AI_REQUESTS_PER_MINUTE=60
# MAX_AI_REQUESTS_PER_DAY=5000
# AI_CIRCUIT_FAIL_THRESHOLD=5
# AI_CIRCUIT_WINDOW_SEC=120
# AI_TIMEOUT_MS=20000

# ─ Test-only (must NEVER be set in production) ──────────────────────────────
# ENABLE_CHAOS_TESTS=true          # allows X-Chaos fault-injection headers
# ECLASH_TEST_MEMORY_STORE=1       # in-process store for tests/load harness
